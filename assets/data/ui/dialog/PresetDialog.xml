<dialog width="387" height="385" title="Select a Preset">
    <scrollview id="presetsList" width="100%" height="100%">
        <grid columns="4">
            <hbox>
                <image resource="assets/images/icons/presetCharacterTab.png"/>
                <label text="Character"/>
            </hbox>
            <label text="Animation"/>
            <spacer/>
            <spacer/>

            <button width="82" height="82" text="SD" icon="assets/images/icons/presets/video.png" tooltip="640x480" userData="CharAnimTab"/>
            <button width="82" height="82" text="HD" icon="assets/images/icons/presets/video.png" tooltip="1280x720" userData="CharAnimTab"/>
            <button width="82" height="82" text="Full HD" icon="assets/images/icons/presets/video.png" tooltip="1920x1080" userData="CharAnimTab"/>
            <button width="82" height="82" text="4K" icon="assets/images/icons/presets/video.png" tooltip="3840x2160" userData="CharAnimTab"/>


            
            <hbox>
                <image resource="assets/images/icons/presetSocialTab.png"/>
                <label text="Social"/>
            </hbox>
            <spacer/>
            <spacer/>
            <spacer/>

            <button width="82" height="82" text="Small" icon="assets/images/icons/presets/FaceBook.png" tooltip="256x144" userData="SocialTab"/>
            <button width="82" height="82" text="Large" icon="assets/images/icons/presets/FaceBook.png" tooltip="3840x2160" userData="SocialTab"/>
