            <button width="82" height="82" text="iPhone-5" icon="assets/images/icons/presets/Phone.png" tooltip="1136x640" userData="WebTab"/>
            <button width="82" height="82" text="iPhone-4" icon="assets/images/icons/presets/Phone.png" tooltip="960x640" userData="WebTab"/>
            <button width="82" height="82" text="iPhone 1-3 Gen" icon="assets/images/icons/presets/Phone.png" tooltip="480x320" userData="WebTab"/>
            <button width="82" height="82" text="Android 16:9" icon="assets/images/icons/presets/Phone.png" tooltip="1280x720" userData="WebTab"/>

            <button width="82" height="82" text="Android 16:10" icon="assets/images/icons/presets/Phone.png" tooltip="1680x1050" userData="WebTab"/>
            <button width="82" height="82" text="Android 5:3" icon="assets/images/icons/presets/Phone.png" tooltip="1280x768" userData="WebTab"/>
            <button width="82" height="82" text="Android 3:2" icon="assets/images/icons/presets/Phone.png" tooltip="960x640" userData="WebTab"/>
            <button width="82" height="82" text="Android 4:3" icon="assets/images/icons/presets/Phone.png" tooltip="1024x768" userData="WebTab"/>

            <button width="82" height="82" text="iPad 3-4 Gen" icon="assets/images/icons/presets/Tablet.png" tooltip="2048x1536" userData="WebTab"/>
            <button width="82" height="82" text="iPad 1-3 Gen" icon="assets/images/icons/presets/Tablet.png" tooltip="1024x768" userData="WebTab"/>
            <spacer/>
            <spacer/>
        </grid>
    </scrollview>

    <window-footer>
        <label text="Hover over an preset to see details!" width="80%"/>
        <button id="selectPresetButton" text="select" height="100%" width="20%"/>
    </window-footer>
