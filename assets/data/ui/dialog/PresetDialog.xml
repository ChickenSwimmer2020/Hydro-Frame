            <button width="82" height="82" text="iPad 1-3 Gen" icon="assets/images/icons/presets/Tablet.png" tooltip="1024x768" userData="GameTab"/>
            <spacer/>
            <spacer/>



            <hbox>
                <image resource="assets/images/icons/presetWebTab.png"/>
                <label text="Web"/>
            </hbox>
            <spacer/>
            <spacer/>
            <spacer/>

            <button width="82" height="82" text="Low" icon="assets/images/icons/presets/Web.png" tooltip="640x480" userData="WebTab"/>
            <button width="82" height="82" text="Medium" icon="assets/images/icons/presets/Web.png" tooltip="800x600" userData="WebTab"/>
            <button width="82" height="82" text="High" icon="assets/images/icons/presets/Web.png" tooltip="960x640" userData="WebTab"/>
