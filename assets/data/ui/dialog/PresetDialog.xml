            <button width="82" height="82" text="Square" icon="assets/images/icons/presets/FaceBook.png" tooltip="600x600" userData="SocialTab"/>

            <button width="82" height="82" text="Vertical" icon="assets/images/icons/presets/FaceBook.png" tooltip="600x750" userData="SocialTab"/>
            <button width="82" height="82" text="In-stream Photo" icon="assets/images/icons/presets/Twitter.png" tooltip="44x220" userData="SocialTab"/>
            <button width="82" height="82" text="Profile Photo" icon="assets/images/icons/presets/Twitter.png" tooltip="400x400" userData="SocialTab"/>
            <button width="82" height="82" text="Header Photo" icon="assets/images/icons/presets/Twitter.png" tooltip="1500x500" userData="SocialTab"/>



            <hbox>
                <image resource="assets/images/icons/presetGameTab.png"/>
                <label text="Game"/>
            </hbox>
            <spacer/>
            <spacer/>
            <spacer/>
            
            <button width="82" height="82" text="Low" icon="assets/images/icons/presets/Web.png" tooltip="640x480" userData="GameTab"/>
            <button width="82" height="82" text="Medium" icon="assets/images/icons/presets/Web.png" tooltip="800x600" userData="GameTab"/>
            <button width="82" height="82" text="High" icon="assets/images/icons/presets/Web.png" tooltip="960x640" userData="GameTab"/>
            <button width="82" height="82" text="Very High" icon="assets/images/icons/presets/Web.png" tooltip="1024x768" userData="GameTab"/>

            <button width="82" height="82" text="iPhone-5" icon="assets/images/icons/presets/Phone.png" tooltip="1136x640" userData="GameTab"/>
            <button width="82" height="82" text="iPhone-4" icon="assets/images/icons/presets/Phone.png" tooltip="960x640" userData="GameTab"/>
            <button width="82" height="82" text="iPhone 1-3 Gen" icon="assets/images/icons/presets/Phone.png" tooltip="480x320" userData="GameTab"/>
            <button width="82" height="82" text="Android 16:9" icon="assets/images/icons/presets/Phone.png" tooltip="1280x720" userData="GameTab"/>

            <button width="82" height="82" text="Android 16:10" icon="assets/images/icons/presets/Phone.png" tooltip="1680x1050" userData="GameTab"/>
            <button width="82" height="82" text="Android 5:3" icon="assets/images/icons/presets/Phone.png" tooltip="1280x768" userData="GameTab"/>
            <button width="82" height="82" text="Android 3:2" icon="assets/images/icons/presets/Phone.png" tooltip="960x640" userData="GameTab"/>
