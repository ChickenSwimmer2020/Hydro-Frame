<vbox width="100%" height="100%" layout="absolute">
    <image style="filter: blur(8px)" resource="assets/images/Background.png" height="100%" width="100%"/>
    <vbox width="100%" height="100%">
        <menubar width="100%" height="5%">
            <menu text="File">
                <menuitem text="New" shortcutText="Ctrl+N" /> <!--newProject()-->
                <menuitem text="Open"/> <!--openFileBrowser()-->
                <menuitem text="OpenRecent"/>
                <menuseparator/>
                <menuitem text="DistrobutionSettings" disabled="true"/>
                <menuseparator/>
                <menuitem text="HScriptSettings" disabled="true"/>
                <menuseparator/>
                <menuitem text="Exit"/> <!--Exit Hydro-Frame-->
            </menu>

            <menu text="Edit">
                <menuitem text="Preferences"/> <!--make preferences window-->
                <menuitem text="FontMapping"/>
                <menuitem text="KeyboardShortcuts"/>
            </menu>

            <menu text="Help">
                <menuitem text="Help" />
                <menuitem text="ReportBug" />
                <menuseparator/>
                <menuitem text="OnlineTutorial" />
                <menuitem text="HandsOnTutorial" />
                <menuseparator/>
                <menuitem text="ManagePlugins" />
                <menuseparator/>
                <menuitem text="CheckforUpdates" />
                <menuseparator/>
                <menuitem text="AbouHydro-Frame" />
            </menu>


            <button id="muteButton" icon="assets/images/icons/mute.png" width="5%" height="100%" horizontalAlign="right"/>
        </menubar>

        <hbox width="100%" height="95%">
            <absolute width="35%" height="25%">
                <box width="100%" height="100%" style="background-color:#000000;background-opacity:.2;border-bottom-right-radius: 10px;" />
                <grid left="5%" top="5%" horizontalAlign="center" columns="6" width="100%" height="100%">
                    <button width="16%" height="95%"> <!--createPresent(1920, 1080, 30, "HScript 2.7", "pixels")-->
                        <item-renderer layout="vertical">
                            <label text="Full\nHD" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                    <button width="16%" height="95%"> <!--createPresent(1280, 720, 30, "HTML5", "pixels")-->
                        <item-renderer layout="vertical">
                            <label text="Android\n16:9" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                    <button width="16%" height="95%"> <!--createPresent(468, 60, 24, "HTML5", "pixels")-->
                        <item-renderer layout="vertical">
                            <label text="Banner" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                    <button width="16%" height="95%"> <!--createPresent(2048, 1536, 30, "HTML5", "pixels")-->
                        <item-renderer layout="vertical">
                            <label text="iPad 3-4\nGen" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                    <button width="16%" height="95%"> <!--createPresent(550, 400, 24, "HTML5", "pixels")-->
                        <item-renderer layout="vertical">
                            <label text="Canvas" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                    <button id="morePresetsButton" width="16%" height="95%"> <!--newProject()-->
                        <item-renderer layout="vertical">
                            <label text="More\nPresets" horizontalAlign="center" />
                            <image resource="haxeui-core/styles/default/haxeui_tiny.png" verticalAlign="center" horizontalAlign="center" />
                        </item-renderer>
                    </button>
                </grid>
            </absolute>
            <spacer width="30%"/>
            <box width="35%" height="95%" style="background-color:#000000;background-opacity:.2;border-top-left-radius: 10px;border-bottom-left-radius: 10px;" /> 
        </hbox>

        <window-list id="windowList" width="100%" height="30" />
    </vbox>
</vbox>

