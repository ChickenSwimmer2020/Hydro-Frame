<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">
    <meta title="Hydro-Frame" description="An HAXE/OPENFL based animation software made to rival Adobe Animate" package="com.chickenswimmer2020.Hydro-Frame" version="0.8.3" company="ChickenSwimmer2020" build-number="0"/>
    <app file="Hydro-Frame" main="Main"/>
    
    


    <source path="source"/>
    <error if="hashlink||hl||html5" value="Platform is sadly currently unsupported due to limitations."/>
    <window width="1280" height="720" hardware="true" allow-high-dpi="true" fps="60" title="Hydro-Frame: Animation Suite" vsync="false" background="#000000"/>
    <assets path="assets"/>

    <haxelib name="lime" version="git"/>
    <haxelib name="openfl" version="git"/>
    <haxelib name="svg" version="1.2.0"/>

    <haxedef name="HXCPP_DEBUGGER" /> <!--alright. thats it, im debugging this properly.-->
    <haxelib name="hxcpp-debugger" />
    <haxedef name="HXCPP_STACK_TRACE"/>
    <haxedef name="HXCPP_STACK_LINE"/>
    <haxedef name="HXCPP_CHECK_POINTER"/>

    <undefine name="openfl-disable-handle-error"/>
    <define name="openfl_enable_handle_error"/>

    <haxeflag name="--macro" value="backend.macro.Stamper.run()" />

    <icon path="assets/images/ICON512.png" size="512" />
    <icon path="assets/images/ICON256.png" size="256" />
    <icon path="assets/images/ICON48.png" size="48" />
    <icon path="assets/images/ICON32.png" size="32" />
    <icon path="assets/images/ICON16.png" size="16" />
</project>