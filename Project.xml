<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

    <set name="VERSION" value="0.10.1" />

    <meta title="Hydro-Frame" />
    <meta description="An HAXE/OPENFL based animation software made to rival Adobe Animate" />
    <meta package="com.chickenswimmer2020.Hydro-Frame" company="ChickenSwimmer2020" />
    <meta version="${VERSION}" build-number="0" />
    <app file="Hydro-Frame" main="Main" />

    <source path="source" />
    <error if="hashlink||hl||html5"
        value="Platform is sadly currently unsupported due to limitations." />
    <window width="1280" height="720" hardware="true" allow-high-dpi="true" fps="60"
        title="Hydro-Frame: Animation Suite" vsync="false" background="#000000" />
    <assets path="assets" />
    <assets path="plugins" />

    <haxelib name="lime" version="git" />
    <haxelib name="format" version="3.8.0" /> <!--How tf did we forget this???-->
    <haxelib name="openfl" version="git" />
    <haxelib name="svg" version="1.2.0" />
    <haxelib name="hxscript" version="git" />

    <haxedef name="HXCPP_DEBUGGER" /> <!--alright.
    thats it, im debugging this properly.-->
    <haxelib name="hxcpp-debugger" />
    <haxedef name="HXCPP_STACK_TRACE" />
    <haxedef name="HXCPP_STACK_LINE" />
    <haxedef name="HXCPP_CHECK_POINTER" />

    <haxedef name="scriptable" if="cpp||mac||linux" />
    <haxedef name="hxscript_cppia" if="cpp||mac||linux" />

    <undefine name="openfl-disable-handle-error" />
    <define name="openfl_enable_handle_error" />

    <haxeflag name="--dce" value="full" unless="debug" />

    <haxeflag name="--macro" value="backend.macro.Stamper.generate()" />
    <haxeflag name="--macro" value="engine.macro.AbstractsMacro.generate()" />
    <haxeflag name="--macro" value="engine.macro.BridgeMacro.generate()" />

    <icon path="assets/images/ICON512.png" size="512" />
    <icon path="assets/images/ICON256.png" size="256" />
    <icon path="assets/images/ICON48.png" size="48" />
    <icon path="assets/images/ICON32.png" size="32" />
    <icon path="assets/images/ICON16.png" size="16" />

    <haxedef name="PRETTY_LOGGING" unless="DISABLE_PRETTY_LOGGING" />

    <haxedef name="DISABLE_GIT_INFO" unless="debug" />
    <haxedef name="GIT_INFO" unless="DISABLE_GIT_INFO" />
    <haxedef name="CLEAR_ON_START" if="true" /> <!--clear the console of build information before traces start.-->
</project>