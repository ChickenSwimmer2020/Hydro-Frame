package engine.nauticink.brush.data;

/**
 * A configuration for a `NauticBrush`.
 * 
 * @since 0.9.0
 */
typedef NauticBrushConfig = {
	/**
	 * The thickness of this `NauticBrush`.
	 * 
	 * @since 0.9.0
	 */
	var ?thickness:Float;

	/**
	 * The color of this `NauticBrush`.
	 * 
	 * @since 0.9.0
	 */
	var ?color:HColor;
}
