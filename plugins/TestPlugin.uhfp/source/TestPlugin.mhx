package;

import backend.plugins.api.PluginAPI;
import backend.plugins.Plugin;

class TestPlugin extends Plugin {
    public static var api:PluginAPI = null;

    public function new() {
        super();
        trace('New plugin!');
        // api = new PluginAPI(this);
        // ^^^ This code would crash! You have to run it at or after onPluginInit(),
        // or else your plugin will not be globally bound yet! 
    }

    override public function onPluginInit() {
        trace('Plugin is making API!');
        api = new PluginAPI(this);
        api.fileAPI.saveContent('test.txt', 'test');
        trace('Just saved file test.txt. Content: ' + api.fileAPI.getContent('test.txt'));
        trace('I won\'t have permission to do this:');
        api.processAPI.createProcess('ls');
    }
}